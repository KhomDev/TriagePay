{
  "label": "synthetic-sample",
  "gates": [
    {
      "id": "scope_statement_present",
      "hard": true,
      "public_explanation": "A finding must state what it claims is in scope.",
      "branches": [
        {
          "when": [
            {
              "eval": "field_empty",
              "field": "scope_statement"
            }
          ],
          "status": "Fail",
          "reason": "scope statement is missing"
        },
        {
          "when": [],
          "status": "Pass",
          "reason": "scope statement provided"
        }
      ]
    },
    {
      "id": "attacker_model_present",
      "hard": false,
      "public_explanation": "A finding must describe who the attacker is.",
      "branches": [
        {
          "when": [
            {
              "eval": "field_empty",
              "field": "attacker_capability"
            }
          ],
          "status": "NeedsEvidence",
          "reason": "attacker capability not provided"
        },
        {
          "when": [],
          "status": "Pass",
          "reason": "attacker capability provided"
        }
      ]
    },
    {
      "id": "permissionless_reachability",
      "hard": true,
      "public_explanation": "A privileged attacker path without a permissionless alternative is not payable.",
      "branches": [
        {
          "when": [
            {
              "all_of": [
                {
                  "eval": "terms_any",
                  "field": "attacker_capability",
                  "params": {
                    "fields": [
                      "attacker_capability",
                      "preconditions"
                    ],
                    "terms": [
                      "admin",
                      "owner",
                      "operator",
                      "privileged",
                      "multisig signer",
                      "only owner"
                    ],
                    "join": ""
                  }
                },
                {
                  "eval": "terms_any",
                  "field": "preconditions",
                  "params": {
                    "fields": [
                      "preconditions"
                    ],
                    "terms": [
                      "permissionless",
                      "unprivileged"
                    ]
                  },
                  "negate": true
                }
              ]
            }
          ],
          "status": "Fail",
          "reason": "attacker path depends on a privileged role without a permissionless alternative"
        },
        {
          "when": [
            {
              "eval": "field_empty",
              "field": "attacker_capability"
            }
          ],
          "status": "NeedsEvidence",
          "reason": "attacker capability not provided"
        },
        {
          "when": [],
          "status": "Pass",
          "reason": "attacker path is reachable without privileged roles"
        }
      ]
    },
    {
      "id": "impact_sink",
      "hard": true,
      "public_explanation": "The claimed impact must name a value sink.",
      "branches": [
        {
          "when": [
            {
              "eval": "field_empty",
              "field": "claimed_impact"
            }
          ],
          "status": "Fail",
          "reason": "claimed impact is empty"
        },
        {
          "when": [
            {
              "eval": "terms_any",
              "field": "claimed_impact",
              "params": {
                "fields": [
                  "claimed_impact"
                ],
                "terms": [
                  "fund",
                  "asset",
                  "value",
                  "loss",
                  "theft",
                  "drain",
                  "mint",
                  "freeze"
                ]
              },
              "negate": true
            }
          ],
          "status": "NeedsEvidence",
          "reason": "claimed impact does not name a value impact"
        },
        {
          "when": [],
          "status": "Pass",
          "reason": "claimed impact names a value impact"
        }
      ]
    },
    {
      "id": "reproduction_non_tautological",
      "hard": true,
      "public_explanation": "A reproduction must describe concrete steps.",
      "branches": [
        {
          "when": [
            {
              "eval": "length_below",
              "field": "reproduction_summary",
              "params": {
                "min": 40
              }
            }
          ],
          "status": "Fail",
          "reason": "reproduction summary is empty or too short"
        },
        {
          "when": [
            {
              "eval": "terms_any",
              "field": "reproduction_summary",
              "params": {
                "fields": [
                  "reproduction_summary"
                ],
                "terms": [
                  "step",
                  "call",
                  "transaction",
                  "reproduce",
                  "1.",
                  "2."
                ]
              },
              "negate": true
            }
          ],
          "status": "NeedsEvidence",
          "reason": "reproduction summary lacks concrete steps"
        },
        {
          "when": [],
          "status": "Pass",
          "reason": "reproduction summary describes concrete steps"
        }
      ]
    },
    {
      "id": "deployed_state_evidence",
      "hard": false,
      "public_explanation": "A payable finding must cite live on-chain state.",
      "branches": [
        {
          "when": [
            {
              "eval": "field_empty",
              "field": "deployed_state_evidence"
            }
          ],
          "status": "NeedsEvidence",
          "reason": "deployed-state evidence is empty"
        },
        {
          "when": [
            {
              "any_of": [
                {
                  "eval": "regex_search",
                  "field": "deployed_state_evidence",
                  "params": {
                    "fields": [
                      "deployed_state_evidence"
                    ],
                    "pattern": "0x[0-9a-f]{8,}"
                  }
                },
                {
                  "eval": "regex_search",
                  "field": "deployed_state_evidence",
                  "params": {
                    "fields": [
                      "deployed_state_evidence"
                    ],
                    "pattern": "\\bblock\\s*[0-9]"
                  }
                }
              ]
            }
          ],
          "status": "Pass",
          "reason": "deployed-state evidence cites on-chain data"
        },
        {
          "when": [],
          "status": "NeedsEvidence",
          "reason": "deployed-state evidence lacks an on-chain reference"
        }
      ]
    },
    {
      "id": "public_rules_snapshot",
      "hard": false,
      "public_explanation": "Program rules must be snapshotted publicly before submission.",
      "branches": [
        {
          "when": [
            {
              "eval": "field_empty",
              "field": "public_rules_snapshot"
            }
          ],
          "status": "NeedsEvidence",
          "reason": "public rules snapshot is empty"
        },
        {
          "when": [
            {
              "eval": "starts_with",
              "field": "public_rules_snapshot",
              "params": {
                "prefixes": [
                  "http://",
                  "https://"
                ]
              }
            }
          ],
          "status": "Pass",
          "reason": "public rules snapshot is a web link"
        },
        {
          "when": [],
          "status": "NeedsEvidence",
          "reason": "public rules snapshot is not a web link"
        }
      ]
    },
    {
      "id": "known_issue_declaration",
      "hard": false,
      "public_explanation": "A declared known issue routes the finding to the held state.",
      "branches": [
        {
          "when": [
            {
              "eval": "field_present",
              "field": "known_issue_declaration"
            }
          ],
          "status": "Pass",
          "reason": "known-issue declaration provided; handled by the decision matrix"
        },
        {
          "when": [],
          "status": "Pass",
          "reason": "no known-issue declaration"
        }
      ]
    },
    {
      "id": "no_loss_concession",
      "hard": true,
      "public_explanation": "A no-loss concession contradicts a value impact claim.",
      "branches": [
        {
          "when": [
            {
              "all_of": [
                {
                  "eval": "terms_any",
                  "field": "reproduction_summary",
                  "params": {
                    "fields": [
                      "reproduction_summary",
                      "claimed_impact"
                    ],
                    "terms": [
                      "no funds are lost",
                      "no fund loss",
                      "no value is extracted"
                    ],
                    "join": ""
                  }
                },
                {
                  "eval": "terms_any",
                  "field": "claimed_impact",
                  "params": {
                    "fields": [
                      "claimed_impact"
                    ],
                    "terms": [
                      "fund",
                      "loss",
                      "theft",
                      "drain"
                    ]
                  }
                }
              ]
            }
          ],
          "status": "Fail",
          "reason": "a no-loss concession contradicts the claimed impact"
        },
        {
          "when": [],
          "status": "Pass",
          "reason": "no contradicting no-loss concession"
        }
      ]
    }
  ],
  "migrations": [
    {
      "id": "m-001",
      "family": "realism",
      "gate_ids": [
        "attacker_model_present",
        "permissionless_reachability"
      ],
      "public_explanation": "Realism gates: the attacker model and permissionless reachability.",
      "introduced_version": "0.1.0"
    },
    {
      "id": "m-002",
      "family": "deployed_state",
      "gate_ids": [
        "deployed_state_evidence"
      ],
      "public_explanation": "Deployed-state gate: the finding must cite live on-chain state.",
      "introduced_version": "0.1.0"
    },
    {
      "id": "m-003",
      "family": "public_evidence",
      "gate_ids": [
        "public_rules_snapshot"
      ],
      "public_explanation": "Public-evidence gate: program rules snapshotted publicly.",
      "introduced_version": "0.1.0"
    },
    {
      "id": "m-004",
      "family": "adversarial_review",
      "gate_ids": [
        "no_loss_concession",
        "reproduction_non_tautological"
      ],
      "public_explanation": "Adversarial review gates: concessions and tautological reproductions.",
      "introduced_version": "0.1.0"
    }
  ]
}
