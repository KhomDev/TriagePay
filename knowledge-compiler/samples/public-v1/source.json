{
  "schema_version": 2,
  "label": "public-generic-v1",
  "gates": [
    {
      "id": "privileged_actor",
      "category": "privileged-actor-required",
      "hard": true,
      "public_explanation": "An attack that needs a privileged actor, with no permissionless route, is rarely payable.",
      "branches": [
        {
          "when": [
            {
              "eval": "privilege_required",
              "params": {
                "capability_fields": ["attacker_capability"],
                "capability_terms": [
                  "admin", "administrator", "owner", "operator", "governance", "governor",
                  "guardian", "keeper", "multisig", "multisig signer", "privileged", "trusted",
                  "timelock", "role holder", "whitelisted", "allowlisted", "deployer",
                  "only owner", "onlyowner", "onlyadmin", "onlyrole"
                ],
                "context_fields": ["preconditions", "hypothesis", "mechanism"],
                "context_phrases": [
                  "requires admin", "requires the admin", "requires an admin", "requires owner",
                  "requires the owner", "requires governance", "requires a governance",
                  "requires the operator", "requires a privileged", "requires privileged",
                  "only the owner can", "only the admin can", "only owner", "onlyowner",
                  "onlyadmin", "onlyrole", "admin must", "owner must", "operator must",
                  "governance must", "the admin sets", "the owner sets", "malicious admin",
                  "malicious owner", "malicious operator", "malicious governance",
                  "compromised admin", "compromised owner", "compromised key",
                  "compromised multisig", "trusted keeper", "trusted role", "privileged role",
                  "admin privileges", "owner privileges", "admin role", "owner role",
                  "governance vote", "governance proposal", "multisig signer",
                  "called by the admin", "called by the owner", "called by governance",
                  "the attacker is the owner", "the attacker is the admin",
                  "admin misconfigures", "owner misconfigures"
                ],
                "escape_fields": ["attacker_capability", "preconditions", "hypothesis"],
                "escape_phrases": [
                  "permissionless", "permissionlessly", "unprivileged", "any user", "anyone",
                  "any caller", "any external", "any address", "any account", "arbitrary user",
                  "arbitrary caller", "arbitrary address", "external attacker",
                  "external caller", "regular user", "normal user", "no special role",
                  "no privileged role", "no role", "without privileges", "without any role",
                  "publicly callable", "front-run", "frontrun", "front-running", "frontrunning"
                ]
              }
            }
          ],
          "status": "Fail",
          "reason": "the attack path depends on a privileged actor and names no permissionless route",
          "penalty": 0.2
        },
        {
          "when": [],
          "status": "Pass",
          "reason": "no privileged-actor dependency detected"
        }
      ]
    },
    {
      "id": "out_of_scope",
      "category": "out-of-scope-component",
      "hard": true,
      "public_explanation": "A component excluded by the program rules is not payable there.",
      "branches": [
        {
          "when": [
            {
              "eval": "rules_section_match",
              "params": {
                "section_markers": [
                  "out of scope", "not in scope", "excluded", "exclusions", "not eligible",
                  "ineligible", "will not be accepted", "are not accepted"
                ],
                "match_fields": ["component_class"],
                "min_overlap": 1
              }
            }
          ],
          "status": "Fail",
          "reason": "the component matches an exclusion in the supplied program rules",
          "penalty": 0.1
        },
        {
          "when": [
            {
              "eval": "phrase_affirmed",
              "params": {
                "fields": ["scope_statement"],
                "phrases": [
                  "out of scope", "not in scope", "outside the scope", "outside of scope",
                  "excluded from scope"
                ]
              }
            }
          ],
          "status": "Fail",
          "reason": "the scope statement places the component outside the program scope",
          "penalty": 0.1
        },
        {
          "when": [],
          "status": "Pass",
          "reason": "no supplied exclusion matches the component"
        }
      ]
    },
    {
      "id": "concession_contradiction",
      "category": "concession-contradicts-impact",
      "hard": true,
      "public_explanation": "A finding that concedes no loss or no profit cannot also claim value impact.",
      "branches": [
        {
          "when": [
            {
              "all_of": [
                {
                  "eval": "concession_present",
                  "params": {
                    "fields": [
                      "title", "hypothesis", "claimed_impact", "mechanism",
                      "attacker_capability", "preconditions", "reproduction_summary"
                    ],
                    "phrases": [
                      "no funds are lost", "no funds can be lost", "no funds will be lost",
                      "no fund loss", "no loss of funds", "no direct loss",
                      "no value is extracted", "no value can be extracted", "no funds at risk",
                      "funds are not at risk", "funds are safe", "funds remain safe",
                      "does not result in a loss", "does not lead to a loss",
                      "does not lead to loss", "no financial loss", "no monetary loss",
                      "no profit for the attacker", "no attacker profit",
                      "attacker does not profit", "the attacker gains nothing",
                      "attacker gains nothing", "not profitable", "unprofitable",
                      "no economic incentive", "no financial incentive",
                      "costs more than it gains", "costs more gas than", "only fee drag",
                      "fee drag only", "only a fee", "only fees", "only dust", "dust amounts",
                      "negligible amount", "negligible loss", "negligible impact",
                      "rounding dust", "only a few wei"
                    ]
                  }
                },
                {
                  "eval": "phrase_affirmed",
                  "params": {
                    "fields": ["claimed_impact", "title"],
                    "phrases": [
                      "loss", "lose", "lost", "theft", "steal", "stolen", "drain", "drained",
                      "fund", "funds", "asset", "assets", "value", "insolvent", "insolvency",
                      "bad debt"
                    ]
                  }
                }
              ]
            }
          ],
          "status": "Fail",
          "reason": "a no-loss, no-profit or fee-only concession contradicts the claimed value impact",
          "penalty": 0.15
        },
        {
          "when": [],
          "status": "Pass",
          "reason": "no concession contradicts the claimed impact"
        }
      ]
    },
    {
      "id": "self_harm",
      "category": "self-harm-only",
      "hard": true,
      "public_explanation": "Harm limited to the caller's own position, or harm that needs user error, is rarely payable.",
      "branches": [
        {
          "when": [
            {
              "eval": "concession_present",
              "params": {
                "fields": [
                  "title", "hypothesis", "claimed_impact", "mechanism", "attacker_capability",
                  "preconditions", "reproduction_summary"
                ],
                "phrases": [
                  "user error", "user mistake", "self-inflicted", "self inflicted",
                  "only affects the caller", "only affects the user", "only affects themselves",
                  "only harms the caller", "only harms themselves", "only harms the user",
                  "their own funds only", "only their own funds", "only lose their own",
                  "only loses their own", "only the caller loses", "the caller only harms",
                  "the user must approve a malicious", "approves a malicious",
                  "user must misconfigure", "user misconfiguration", "fat finger", "by mistake"
                ]
              }
            }
          ],
          "status": "Fail",
          "reason": "the harm is limited to the caller's own position or needs user error",
          "penalty": 0.2
        },
        {
          "when": [],
          "status": "Pass",
          "reason": "no self-harm-only admission detected"
        }
      ]
    },
    {
      "id": "known_issue",
      "category": "known-issue-declared",
      "hard": false,
      "public_explanation": "A declared or listed known issue routes the finding to human review.",
      "branches": [
        {
          "when": [
            {
              "eval": "field_present",
              "field": "known_issue_declaration"
            }
          ],
          "status": "Held",
          "reason": "a known-issue declaration is attached",
          "penalty": 0.4
        },
        {
          "when": [
            {
              "eval": "rules_section_match",
              "params": {
                "section_markers": [
                  "known issue", "known issues", "acknowledged issues", "acknowledged risks",
                  "accepted risks", "known risks", "previous audit findings", "won't fix"
                ],
                "match_fields": ["title"],
                "min_overlap": 3
              }
            }
          ],
          "status": "Held",
          "reason": "the supplied program rules list a matching known issue",
          "penalty": 0.4
        },
        {
          "when": [
            {
              "eval": "phrase_affirmed",
              "params": {
                "fields": ["title", "hypothesis", "mechanism", "claimed_impact"],
                "phrases": [
                  "known issue", "previously reported", "already reported",
                  "reported in a previous audit", "duplicate of", "won't fix", "wontfix",
                  "listed as a known"
                ]
              }
            }
          ],
          "status": "Held",
          "reason": "the finding text describes itself as a known or previously reported issue",
          "penalty": 0.5
        },
        {
          "when": [],
          "status": "Pass",
          "reason": "no known-issue declaration or matching known-issue entry"
        }
      ]
    },
    {
      "id": "design_intent",
      "category": "design-intent-likely",
      "hard": false,
      "public_explanation": "Behaviour that reads as documented or intended design routes the finding to human review.",
      "branches": [
        {
          "when": [
            {
              "eval": "concession_present",
              "params": {
                "fields": ["title", "hypothesis", "claimed_impact", "mechanism", "reproduction_summary"],
                "phrases": [
                  "by design", "as designed", "working as intended", "works as intended",
                  "design choice", "design decision", "deliberate design", "intentional design",
                  "documented as intended", "documented behavior", "documented behaviour"
                ]
              }
            }
          ],
          "status": "Held",
          "reason": "the finding describes behaviour that reads as documented or intended design",
          "penalty": 0.5
        },
        {
          "when": [
            {
              "eval": "rules_section_match",
              "params": {
                "section_markers": [
                  "by design", "intended behavior", "intended behaviour", "accepted risk",
                  "accepted risks", "acceptable risk", "design decisions", "design choices"
                ],
                "match_fields": ["title"],
                "min_overlap": 3
              }
            }
          ],
          "status": "Held",
          "reason": "the supplied program rules describe matching behaviour as intended",
          "penalty": 0.5
        },
        {
          "when": [],
          "status": "Pass",
          "reason": "no design-intent admission detected"
        }
      ]
    },
    {
      "id": "theoretical_only",
      "category": "theoretical-only",
      "hard": false,
      "public_explanation": "A hedged impact without a concrete reproduction needs evidence.",
      "branches": [
        {
          "when": [
            {
              "eval": "phrase_affirmed",
              "params": {
                "fields": ["title", "hypothesis", "claimed_impact", "mechanism"],
                "phrases": [
                  "theoretically", "in theory", "could potentially", "might potentially",
                  "may potentially", "might be possible", "may be possible",
                  "could be possible", "hypothetically", "speculative", "not yet confirmed",
                  "unconfirmed", "not been tested", "untested", "not been verified"
                ]
              }
            },
            {
              "eval": "length_below",
              "field": "reproduction_summary",
              "params": {"min": 40}
            },
            {
              "eval": "field_empty",
              "field": "code_context"
            }
          ],
          "status": "NeedsEvidence",
          "reason": "the impact is hedged and no concrete reproduction or code context is supplied",
          "penalty": 0.6
        },
        {
          "when": [
            {"eval": "field_empty", "field": "reproduction_summary"},
            {"eval": "field_empty", "field": "code_context"},
            {"eval": "field_empty", "field": "code_excerpt"},
            {
              "eval": "phrase_affirmed",
              "negate": true,
              "params": {
                "fields": ["hypothesis", "mechanism"],
                "phrases": [
                  "proof of concept", "poc", "step 1", "steps to reproduce", "reproduce",
                  "reproduction", "test case", "forge test", "foundry", "hardhat", "assert",
                  "asserteq", "function test", "coded poc", "run the test", "attack scenario",
                  "attack path"
                ]
              }
            }
          ],
          "status": "NeedsEvidence",
          "reason": "no reproduction steps, proof of concept or code context is supplied",
          "penalty": 0.9
        },
        {
          "when": [],
          "status": "Pass",
          "reason": "the finding carries concrete reproduction material"
        }
      ]
    },
    {
      "id": "quantified_impact",
      "category": "no-quantified-impact",
      "hard": false,
      "public_explanation": "A payable impact is stated as an amount, a percentage or a token quantity bound to a loss.",
      "branches": [
        {
          "when": [
            {"eval": "field_empty", "field": "claimed_impact"},
            {"eval": "field_empty", "field": "hypothesis"}
          ],
          "status": "NeedsEvidence",
          "reason": "no impact is stated",
          "penalty": 0.7
        },
        {
          "when": [
            {
              "eval": "quantified_impact",
              "negate": true,
              "params": {
                "fields": [
                  "title", "claimed_impact", "hypothesis", "mechanism", "reproduction_summary"
                ],
                "impact_terms": [
                  "lose", "loses", "lost", "loss", "losses", "losing", "steal", "steals",
                  "stolen", "theft", "drain", "drains", "drained", "draining", "extract",
                  "extracts", "extracted", "siphon", "siphoned", "skim", "skims", "mint",
                  "mints", "minted", "inflate", "inflates", "inflated", "freeze", "frozen",
                  "lock", "locked", "stuck", "burn", "burned", "burnt", "insolvent",
                  "insolvency", "bad debt", "overpay", "overpays", "underpay", "underpaid",
                  "profit", "profits", "gain", "gains", "overcharged", "undercollateralized",
                  "liquidated", "liquidation"
                ],
                "unit_terms": [
                  "usd", "usdc", "usdt", "dai", "eth", "weth", "wei", "gwei", "btc", "wbtc",
                  "near", "sol", "tokens", "token", "shares", "share", "units", "unit",
                  "dollars", "ether", "x"
                ],
                "absolute_phrases": [
                  "all funds", "all user funds", "all deposits", "all assets",
                  "entire balance", "entire pool", "entire vault", "whole pool",
                  "whole balance", "total supply", "all collateral", "all rewards",
                  "full balance", "100 %"
                ],
                "window": 12
              }
            }
          ],
          "status": "NeedsEvidence",
          "reason": "the impact is not quantified: no amount, percentage or token quantity is bound to a loss",
          "penalty": 0.85
        },
        {
          "when": [],
          "status": "Pass",
          "reason": "the impact names a quantity bound to a loss"
        }
      ]
    },
    {
      "id": "deployment_evidence",
      "category": "unverified-deployment-evidence",
      "hard": false,
      "public_explanation": "Deployment references are checked for format only; a malformed or placeholder reference cannot be verified.",
      "branches": [
        {
          "when": [
            {
              "eval": "evidence_format",
              "params": {
                "fields": ["deployed_state_evidence", "evidence_refs"],
                "expect": "placeholder"
              }
            }
          ],
          "status": "NeedsEvidence",
          "reason": "the deployment reference is malformed or a placeholder; it cannot be verified",
          "penalty": 0.8
        },
        {
          "when": [
            {"eval": "field_empty", "field": "deployed_state_evidence"},
            {
              "eval": "evidence_format",
              "params": {"fields": ["source_ref"], "expect": "pinned_source"}
            }
          ],
          "status": "Pass",
          "reason": "a pinned source reference is supplied (pre-deployment review; format-level check only)"
        },
        {
          "when": [
            {"eval": "field_empty", "field": "deployed_state_evidence"}
          ],
          "status": "NeedsEvidence",
          "reason": "no deployment evidence or pinned source reference is supplied",
          "penalty": 1.0
        },
        {
          "when": [
            {
              "eval": "evidence_format",
              "negate": true,
              "params": {
                "fields": ["deployed_state_evidence", "evidence_refs"],
                "expect": "onchain_ref"
              }
            }
          ],
          "status": "NeedsEvidence",
          "reason": "the deployment evidence cites no well-formed on-chain reference",
          "penalty": 0.9
        },
        {
          "when": [],
          "status": "Pass",
          "reason": "the deployment evidence cites a well-formed on-chain reference (format-level check only; not verified on chain)"
        }
      ]
    }
  ],
  "migrations": [
    {
      "id": "m-101",
      "family": "stage_a",
      "gate_ids": [
        "privileged_actor",
        "out_of_scope",
        "concession_contradiction",
        "self_harm",
        "known_issue",
        "design_intent",
        "theoretical_only",
        "quantified_impact",
        "deployment_evidence"
      ],
      "introduced_version": "1.0.0",
      "public_explanation": "Triage engine v2 Stage A: structured, negation-aware gates mapped onto the public taxonomy."
    }
  ]
}
