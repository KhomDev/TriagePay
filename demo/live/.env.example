# Hosted judge demo. Copy to the Vercel project (or export in the shell).
# Never commit a filled copy. The fallback files under demo/live/.keys/ are
# gitignored and are ignored entirely when VERCEL is set.

# Required. ed25519 secret of the agent's function-call key (pay only).
TRIAGEPAY_AGENT_SECRET_KEY=

# Required. ed25519 secret of the owner account. Revoke, restore, approve,
# reject, and the kill switch.
TRIAGEPAY_OWNER_SECRET_KEY=

# Optional. Public values default to demo/live/config.json.
# TRIAGEPAY_RPC_URL=https://test.rpc.fastnear.com
# TRIAGEPAY_OWNER_ACCOUNT=
# TRIAGEPAY_AGENT_ACCOUNT=
# TRIAGEPAY_WALLET_ACCOUNT=
# TRIAGEPAY_TOKEN_ACCOUNT=
# TRIAGEPAY_PAYEE_ACCOUNT=
# TRIAGEPAY_INJECTED_ACCOUNT=
# TRIAGEPAY_FLAGGED_ACCOUNT=
# TRIAGEPAY_COOLDOWN_SECONDS=20
# TRIAGEPAY_MAX_ATTEMPTS_PER_DAY=40
# TRIAGEPAY_IP_LIMIT=4
# TRIAGEPAY_IP_WINDOW_SECONDS=60

# Shared attempt counters. Either pair works (Vercel KV or Upstash Redis).
# Without them the server still caps the UTC day from the chain index and
# applies a per-address limit only inside one instance. If these are set
# and the store does not answer, signing is refused.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional. The attestation panel works without it. When set, Launch and
# Drain Me ask this model to call pay. Without it, the page says scripted.
# NEARAI_API_KEY=
# NEARAI_MODEL=z-ai/glm-5.3-flash
# NEARAI_BASE_URL is not read. The client uses https://cloud-api.near.ai/v1.

# Optional. Held payments message this chat with Approve and Reject.
# The webhook also needs TELEGRAM_WEBHOOK_SECRET, sent as
# X-Telegram-Bot-Api-Secret-Token. See docs/demo/live-features.md.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=

# Optional. HMAC key for the one-time revoke link. Without it the Kill
# switch card says it cannot mint a link.
# KILL_SWITCH_SECRET=
# KILL_SWITCH_TTL_SECONDS=600

# Set to 1 to let the policy sentence sign set_agent / set_review_policy.
# Leave unset on the public demo. Preview still works.
# TRIAGEPAY_POLICY_APPLY=

# Honeypot payee. Defaults to TRIAGEPAY_INJECTED_ACCOUNT / config injected.
# TRIAGEPAY_HONEYPOT_ACCOUNT=

# Drain Me per-address cap. Defaults: 3 attempts per 600 seconds.
# TRIAGEPAY_DRAIN_IP_LIMIT=3
# TRIAGEPAY_DRAIN_WINDOW_SECONDS=600

# Optional. When set, /api/cron requires Authorization: Bearer <value>.
# CRON_SECRET=

# Full-access key of the agent account. Used only by `node setup.mjs cleanup`.
# TRIAGEPAY_AGENT_FULL_SECRET_KEY=
