# Hosted judge demo. Copy to the Vercel project (or export in the shell).
# Never commit a filled copy. The fallback files under demo/live/.keys/ are
# gitignored and are ignored entirely when VERCEL is set.

# Required. ed25519 secret of the agent's function-call key (pay only).
TRIAGEPAY_AGENT_SECRET_KEY=

# Required. ed25519 secret of the owner account. Revoke and restore only.
TRIAGEPAY_OWNER_SECRET_KEY=

# Optional. Public values default to demo/live/config.json.
# TRIAGEPAY_RPC_URL=https://test.rpc.fastnear.com
# TRIAGEPAY_OWNER_ACCOUNT=
# TRIAGEPAY_AGENT_ACCOUNT=
# TRIAGEPAY_WALLET_ACCOUNT=
# TRIAGEPAY_TOKEN_ACCOUNT=
# TRIAGEPAY_PAYEE_ACCOUNT=
# TRIAGEPAY_INJECTED_ACCOUNT=
# TRIAGEPAY_FLAGGED_ACCOUNT=
# TRIAGEPAY_COOLDOWN_SECONDS=20
# TRIAGEPAY_MAX_ATTEMPTS_PER_DAY=40
# TRIAGEPAY_IP_LIMIT=4
# TRIAGEPAY_IP_WINDOW_SECONDS=60

# Shared attempt counters. Either pair works (Vercel KV or Upstash Redis).
# Without them the server still caps the UTC day from the chain index and
# applies a per-address limit only inside one instance. If these are set
# and the store does not answer, signing is refused.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional. The attestation panel works without it. A key is used only as
# Authorization on the report request; this demo does not send a completion.
# NEARAI_API_KEY=

# Optional. When set, /api/cron requires Authorization: Bearer <value>.
# CRON_SECRET=

# Full-access key of the agent account. Used only by `node setup.mjs cleanup`.
# TRIAGEPAY_AGENT_FULL_SECRET_KEY=
