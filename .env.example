# TriagePay environment template.
# Copy to a location OUTSIDE this repository (the reference setup keeps it
# one directory above the repo) and fill in real values. Never commit a
# populated .env; the repository must stay secret-free.

# --- Payment provider -----------------------------------------------------
# "mock" (default; fully offline) or "near" (on-chain deposit verification).
APS_PROVIDER=mock

# --- NEAR adapter (required when APS_PROVIDER=near) -----------------------
# mainnet or testnet.
NEAR_NETWORK=mainnet
# The gateway's NEAR account id: where deposits land. This is a public
# on-chain identifier, not a secret.
NEAR_GATEWAY_ACCOUNT=
# The NEP-141 settlement asset contract. Mainnet native USDC (6 decimals),
# verified by ft_metadata on 2026-10-21 - see docs/integrations/near.md.
# Bridged USDC.e (a0b86991c6218b36c1d19d4a2e9eb0ce3606eb48.factory.bridge.near)
# is a legacy token and is not the settlement asset.
NEAR_ASSET_CONTRACT=17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
# JSON-RPC endpoint. Must answer the NEAR JSON-RPC surface (status, query,
# tx). Defaults to FASTNEAR's free endpoint for NEAR_NETWORK when empty
# (https://free.rpc.fastnear.com for mainnet, https://test.rpc.fastnear.com
# for testnet). The official rpc.mainnet.near.org / rpc.testnet.near.org
# endpoints are deprecated and reject every request (HTTP 429, 2026-11-06).
# A privacy RPC (for example 1rpc.io) must be verified first: not all of
# them expose the NEAR method set.
NEAR_RPC_URL=https://free.rpc.fastnear.com
# Per-call RPC timeout in seconds (default 15).
NEAR_RPC_TIMEOUT_SECS=15

# --- Optional: wallet inspection (read-only preflight) --------------------
# The account holding the operator's deposited USDC, used only by
# scripts/near-preflight.py (read-only view calls). Never read by the
# service itself; the adapter holds no private keys.
NEAR_ACCOUNT_ID=

# --- API ------------------------------------------------------------------
# Listen port (loopback only).
APS_PORT=8080
# Scanner subprocess configuration (see README).
APS_SCANNER_PYTHON=
APS_SCANNER_DIR=
APS_SCANNER_TIMEOUT_SECS=30

# NOTE: private keys are deliberately NOT part of this template. The
# service signs nothing; any key material belongs to the operator's wallet
# tooling, never to this repository or its environment.
#
# The hosted judge demo is the exception. It signs on testnet from a
# serverless function. Its variables are listed in demo/live/.env.example
# and are set on the Vercel project, not in this file.
