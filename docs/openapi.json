              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "deposit receipt (replay)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "receipt payload (see the README wire examples)"
                }
              }
            }
          },
          "201": {
            "description": "deposit receipt (new)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "receipt payload (see the README wire examples)"
                }
              }
            }
          },
          "400": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "dev_only_route: a provider that settles real payments is active, so credit enters an account only from a provider-observed confirmation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
