              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "observation + reconciliation outcome (+deposit receipt when funded)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "receipt payload (see the README wire examples)"
                }
              }
            }
          },
          "400": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
