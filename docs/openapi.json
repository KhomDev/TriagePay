              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "refund receipt/proposal",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "receipt payload (see the README wire examples)"
                }
              }
            }
          },
          "400": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "error",
