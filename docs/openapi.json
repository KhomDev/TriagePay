      }
    },
    "/jobs/{job_id}/scan": {
      "post": {
        "summary": "Run the scanner subprocess and settle against the report hash; payment covers the scan, not the verdict",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "The finding envelope; the scanner is the schema authority"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "settlement + report (replay)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "receipt payload (see the README wire examples)"
                }
              }
            }
          },
          "201": {
            "description": "settlement + report (new)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "receipt payload (see the README wire examples)"
                }
              }
            }
          },
          "400": {
            "description": "envelope failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
