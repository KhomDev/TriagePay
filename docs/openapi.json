{
  "openapi": "3.1.0",
  "info": {
    "title": "TriagePay API",
    "version": "0.1.0",
    "description": "Prepaid, policy-guarded payment rails for AI agent tools. All money crosses the wire as u128 atomic units encoded as JSON strings plus a display-only decimal. Every money-moving request carries a caller-scoped idempotency key. One error shape everywhere: {\"error\":{\"code\",\"message\"}}.",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "loopback only"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{account_id}": {
      "get": {
        "summary": "Current balances, or 404",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          }
        ],
        "responses": {
          "200": {
            "description": "balances",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Balances"
                }
              }
            }
          },
          "404": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{account_id}/deposits": {
